{
    "schemaVersion": 1,
    "id": "randomblockplacement",
    "version": "${version}",
    "name": "RandomBlockPlacement",
    "description": "Simple placement of random blocks from hotbar!",
    "authors": ["MEGATREX4", "illyrius666"],
    "contact": {
        "homepage": "https://xodium.org/",
        "sources": "https://github.com/XodiumSoftware/randomblockplacement"
    },
    "license": "AGPL-3.0",
    "icon": "assets/randomblockplacement/icon.png",
    "environment": "*",
    "entrypoints": {
        "main": [
            {
                "adapter": "kotlin",
                "value": "org.xodium.RandomBlockPlacement"
            }
        ],
        "client": [
            {
                "adapter": "kotlin",
                "value": "org.xodium.RandomBlockPlacementClient"
            }
        ],
        "fabric-datagen": [
            {
                "adapter": "kotlin",
                "value": "org.xodium.data.RandomBlockPlacementDataGenerator"
            }
        ]
    },
    "mixins": [
        "randomblockplacement.mixins.json",
        {
            "config": "randomblockplacement.client.mixins.json",
            "environment": "client"
        }
    ],
    "depends": {
        "fabricloader": ">=0.19.5",
        "minecraft": "~26.3",
        "java": ">=25",
        "fabric-api": "*",
        "fabric-language-kotlin": ">=1.14.2"
    }
}
